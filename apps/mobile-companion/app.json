{
  "expo": {
    "name": "DSH Orbit",
    "slug": "dsh-mobile",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "dshcompanion",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#06172B"
    },
    "ios": {
      "bundleIdentifier": "com.dshext.companion",
      "supportsTablet": false,"buildNumber": "5",
      "infoPlist": {
        "NSCameraUsageDescription": "DSH Orbit uses the camera only to scan the pairing QR code shown on your computer.",
        "NSFaceIDUsageDescription": "DSH Orbit uses Face ID to unlock so your paired credential stays protected.",
        "CFBundleDevelopmentRegion": "vi",
        "CFBundleLocalizations": [
          "vi",
          "en"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dshext.companion",
      "versionCode": 9,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "monochromeImage": "./assets/adaptive-monochrome.png",
        "backgroundColor": "#06172B"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow DSH Orbit to scan the pairing QR code shown on your computer."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow DSH Orbit to unlock with Face ID so your paired credential stays protected."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      [
        "./plugins/withPinnedWsConfig",
        {
          "locales": [
            "en",
            "vi"
          ]
        }
      ],
      "./plugins/withAndroidReleaseSigning",
      "./plugins/withAndroidOptionalPortrait"
    ],
    "experiments": {
      "typedRoutes": false,
      "autolinkingModuleResolution": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "1352584f-32b4-4f00-9852-664315751e64"
      }
    },
    "owner": "nesteacolds-team"
  }
}
